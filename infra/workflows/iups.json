{
  "$schema": "https://schema.management.azure.com/providers/Microsoft.Logic/schemas/2016-06-01/workflowdefinition.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "$connections": { "type": "Object", "defaultValue": {} },
    "functionUrl": { "type": "String" },
    "functionKey": { "type": "SecureString" },
    "translatorKey": { "type": "SecureString" },
    "translatorRegion": { "type": "String" }
  },
  "triggers": {
    "manual": {
      "type": "Request",
      "kind": "Http",
      "operationOptions": "EnableSchemaValidation",
      "inputs": {
        "method": "POST",
        "relativePath": "claims/{claimId}/evidence",
        "schema": {
          "type": "object",
          "required": ["evidenceId", "userId", "fileName", "data"],
          "properties": {
            "evidenceId": { "type": "string" },
            "userId": { "type": "integer" },
            "fileName": { "type": "string" },
            "caption": { "type": "string" },
            "area": { "type": "string" },
            "damageTags": { "type": "array", "items": { "type": "string" } },
            "data": { "type": "string" }
          }
        }
      }
    }
  },
  "actions": {
    "Inspect_image": {
      "type": "Http",
      "runAfter": {},
      "inputs": {
        "method": "POST",
        "uri": "@{parameters('functionUrl')}/api/inspect",
        "headers": { "x-functions-key": "@parameters('functionKey')" },
        "body": {
          "fileName": "@triggerBody()?['fileName']",
          "data": "@triggerBody()?['data']"
        }
      },
      "runtimeConfiguration": { "secureData": { "properties": ["inputs"] } }
    },
    "Reject_file": {
      "type": "Response",
      "kind": "Http",
      "runAfter": { "Inspect_image": ["Failed", "TimedOut"] },
      "inputs": {
        "statusCode": "@coalesce(outputs('Inspect_image')?['statusCode'], 502)",
        "headers": { "Content-Type": "application/json" },
        "body": "@body('Inspect_image')"
      }
    },
    "Translate_caption": {
      "type": "Http",
      "runAfter": { "Inspect_image": ["Succeeded"] },
      "inputs": {
        "method": "POST",
        "uri": "https://api.cognitive.microsofttranslator.com/translate?api-version=3.0&to=en",
        "headers": {
          "Ocp-Apim-Subscription-Key": "@parameters('translatorKey')",
          "Ocp-Apim-Subscription-Region": "@parameters('translatorRegion')",
          "Content-Type": "application/json"
        },
        "body": [{ "Text": "@{coalesce(triggerBody()?['caption'], '')}" }]
      },
      "runtimeConfiguration": { "secureData": { "properties": ["inputs"] } }
    },
    "Register_evidence": {
      "type": "ApiConnection",
      "runAfter": { "Translate_caption": ["Succeeded"] },
      "inputs": {
        "host": { "connection": { "name": "@parameters('$connections')['sql']['connectionId']" } },
        "method": "post",
        "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))},@{encodeURIComponent(encodeURIComponent('default'))}/procedures/@{encodeURIComponent(encodeURIComponent('[dbo].[usp_CreateEvidence]'))}",
        "body": {
          "evidenceId": "@triggerBody()?['evidenceId']",
          "claimRef": "@triggerOutputs()['relativePathParameters']['claimId']",
          "userId": "@triggerBody()?['userId']",
          "fileName": "@triggerBody()?['fileName']",
          "contentType": "@body('Inspect_image')?['contentType']",
          "sizeBytes": "@body('Inspect_image')?['sizeBytes']",
          "sha256": "@body('Inspect_image')?['sha256']",
          "caption": "@triggerBody()?['caption']"
        }
      }
    },
    "Registration": {
      "type": "Compose",
      "runAfter": { "Register_evidence": ["Succeeded"] },
      "inputs": "@first(body('Register_evidence')?['resultsets']?['Table1'])"
    },
    "If_registered": {
      "type": "If",
      "runAfter": { "Registration": ["Succeeded"] },
      "expression": { "and": [{ "equals": ["@outputs('Registration')?['httpStatus']", 201] }] },
      "actions": {
        "Store_evidence": {
          "type": "Scope",
          "runAfter": {},
          "actions": {
            "Create_blob": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": { "connection": { "name": "@parameters('$connections')['azureblob']['connectionId']" } },
                "method": "post",
                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('AccountNameFromSettings'))}/files",
                "queries": {
                  "folderPath": "/evidence-originals/claims/@{outputs('Registration')?['claimRef']}",
                  "name": "@{last(split(outputs('Registration')?['fileLocator'], '/'))}",
                  "queryParametersSingleEncoded": true
                },
                "headers": { "ReadFileMetadataFromServer": true },
                "body": "@base64ToBinary(triggerBody()?['data'])"
              }
            },
            "Save_metadata": {
              "type": "ApiConnection",
              "runAfter": { "Create_blob": ["Succeeded"] },
              "inputs": {
                "host": { "connection": { "name": "@parameters('$connections')['documentdb']['connectionId']" } },
                "method": "post",
                "path": "/v2/cosmosdb/@{encodeURIComponent('AccountNameFromSettings')}/dbs/@{encodeURIComponent('evidence')}/colls/@{encodeURIComponent('metadata')}/docs",
                "headers": {
                  "x-ms-documentdb-raw-partitionkey": "\"@{outputs('Registration')?['claimRef']}\"",
                  "x-ms-documentdb-is-upsert": true
                },
                "body": {
                  "id": "@{outputs('Registration')?['evidenceId']}",
                  "claimId": "@{outputs('Registration')?['claimRef']}",
                  "fileLocator": "@{outputs('Registration')?['fileLocator']}",
                  "area": "@triggerBody()?['area']",
                  "damageTags": "@coalesce(triggerBody()?['damageTags'], json('[]'))",
                  "captionLang": "@body('Translate_caption')?[0]?['detectedLanguage']?['language']",
                  "captionEn": "@body('Translate_caption')?[0]?['translations']?[0]?['text']",
                  "exif": "@body('Inspect_image')?['exif']",
                  "uploadedUtc": "@{utcNow()}",
                  "schemaVersion": 1
                }
              }
            }
          }
        },
        "Created": {
          "type": "Response",
          "kind": "Http",
          "runAfter": { "Store_evidence": ["Succeeded"] },
          "inputs": {
            "statusCode": 201,
            "headers": { "Content-Type": "application/json" },
            "body": {
              "evidenceId": "@{outputs('Registration')?['evidenceId']}",
              "claimId": "@{outputs('Registration')?['claimRef']}",
              "fileLocator": "@{outputs('Registration')?['fileLocator']}",
              "sha256": "@body('Inspect_image')?['sha256']",
              "status": "Active"
            }
          }
        },
        "Compensate": {
          "type": "Scope",
          "runAfter": { "Store_evidence": ["Failed", "TimedOut"] },
          "actions": {
            "Delete_blob": {
              "type": "ApiConnection",
              "runAfter": {},
              "inputs": {
                "host": { "connection": { "name": "@parameters('$connections')['azureblob']['connectionId']" } },
                "method": "delete",
                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('AccountNameFromSettings'))}/files/@{encodeURIComponent(encodeURIComponent(body('Create_blob')?['Id']))}"
              }
            },
            "Rollback_registration": {
              "type": "ApiConnection",
              "runAfter": { "Delete_blob": ["Succeeded", "Failed", "Skipped"] },
              "inputs": {
                "host": { "connection": { "name": "@parameters('$connections')['sql']['connectionId']" } },
                "method": "post",
                "path": "/v2/datasets/@{encodeURIComponent(encodeURIComponent('default'))},@{encodeURIComponent(encodeURIComponent('default'))}/procedures/@{encodeURIComponent(encodeURIComponent('[dbo].[usp_RollbackEvidence]'))}",
                "body": { "evidenceId": "@triggerBody()?['evidenceId']" }
              }
            },
            "Upload_failed": {
              "type": "Response",
              "kind": "Http",
              "runAfter": { "Rollback_registration": ["Succeeded", "Failed"] },
              "inputs": {
                "statusCode": 500,
                "headers": { "Content-Type": "application/json" },
                "body": { "error": "The photo could not be stored and nothing was kept. Please try again." }
              }
            }
          }
        }
      },
      "else": {
        "actions": {
          "Not_registered": {
            "type": "Response",
            "kind": "Http",
            "runAfter": {},
            "inputs": {
              "statusCode": "@outputs('Registration')?['httpStatus']",
              "headers": { "Content-Type": "application/json" },
              "body": "@outputs('Registration')"
            }
          }
        }
      }
    }
  },
  "outputs": {}
}
